{
	"name": "@nyancorn/agentests-security",
	"version": "1.1.0",
	"description": "Test an AI API's defenses against model extraction in CI: rate limits, quotas, and detection, as bounded, deterministic security policies.",
	"keywords": [
		"ai-security",
		"model-extraction",
		"distillation",
		"llm",
		"rate-limiting",
		"api-security",
		"security-testing",
		"policy-as-code",
		"ci-cd",
		"agentests"
	],
	"license": "MIT",
	"author": "mlgxiii",
	"homepage": "https://github.com/mlgxiii/agentests-security#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mlgxiii/agentests-security.git"
	},
	"bugs": "https://github.com/mlgxiii/agentests-security/issues",
	"type": "module",
	"bin": {
		"agentests-security": "dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./schema.json": "./schema/policy.schema.json"
	},
	"files": [
		"dist",
		"schema",
		"README.md",
		"LICENSE",
		"STABILITY.md",
		"SECURITY.md",
		"CHANGELOG.md"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.json",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "npm run build && bun test ./tests",
		"prepublishOnly": "npm test",
		"schema": "bun scripts/schema.ts"
	},
	"dependencies": {
		"clinguini": "^1.0.1",
		"yaml": "2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^22",
		"typescript": "^6.0.3"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
