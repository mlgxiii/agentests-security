{
	"compilerOptions": {
		"lib": ["ESNext"],
		"types": ["node"],
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"verbatimModuleSyntax": true,
		"rewriteRelativeImportExtensions": true,
		"strict": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"declaration": true,
		"rootDir": "src",
		"outDir": "dist"
	},
	"include": ["src"]
}
